amends "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Builtins.pkl"

local shellScriptsMatch: List<FileSelector> = List(
    new FileSelector { glob = List("**/*.sh", "**/*.bash") },
    // Extensionless mise tasks are identified by their shell shebang.
    new FileSelector { glob = List(".config/mise/tasks/**"); types = List("sh", "bash") }
)

local builtin_linters = new Mapping<String, Step> {
    ["check_added_large_files"] = Builtins.check_added_large_files
    ["check_case_conflict"] = Builtins.check_case_conflict
    ["check_executables_have_shebangs"] = Builtins.check_executables_have_shebangs
    ["check_symlinks"] = Builtins.check_symlinks
    ["gitleaks"] = Builtins.gitleaks
    ["jq"] = Builtins.jq
    ["mise"] = Builtins.mise
    ["newlines"] = Builtins.newlines
    ["trailing_whitespace"] = Builtins.trailing_whitespace
}

local project_linters = new Mapping<String, Step> {
    ["yamlfmt"] {
        glob = List("**/*.yml", "**/*.yaml")
        check = "./scripts/tools/yamlfmt/yamlfmt.bash --lint {{files}}"
        fix = "./scripts/tools/yamlfmt/yamlfmt.bash --format {{files}}"
    }
    ["actionlint"] {
        ...Builtins.actionlint
        depends = List("yamlfmt")
    }
    // Project wrappers: ShellCheck config via SHELLCHECK_RCFILE / .shellcheckrc;
    // shfmt formatting via .editorconfig. Pass hk-matched files explicitly (no --all).
    ["shellcheck"] {
        match_any = shellScriptsMatch
        check = "./scripts/tools/shellcheck/shellcheck.bash --lint {{files}}"
        fix = "./scripts/tools/shellcheck/shellcheck.bash --format {{files}}"
    }
    ["shfmt"] {
        match_any = shellScriptsMatch
        // Run after shellcheck so auto-fixes are reformatted consistently.
        depends = List("shellcheck")
        check = "./scripts/tools/shfmt/shfmt.bash --lint {{files}}"
        fix = "./scripts/tools/shfmt/shfmt.bash --format {{files}}"
    }
    ["swift-format"] {
        glob = List("**/*.swift")
        check = "./scripts/tools/swift-format/swift-format.bash --lint {{files}}"
        fix = "./scripts/tools/swift-format/swift-format.bash --format {{files}}"
    }
}

local linters = new Mapping<String, Step> {
    ...builtin_linters
    ...project_linters
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    // {{commit_msg_file}} / {{source}} are only defined for commit-msg / prepare-commit-msg
    ["prepare-commit-msg"] {
        steps {
            ["commit-msg-add-jira-issue"] {
                check = "scripts/tools/git/hooks/prepare-commit-msg/append-jira-issue.bash {{commit_msg_file}} {{source}}"
                output_summary = "combined"
            }
        }
    }
    ["commit-msg"] {
        steps {
            ["check_conventional_commit"] = Builtins.check_conventional_commit
        }
    }
    ["post-checkout"] {
        steps {
            ["mise-install"] {
                check = "scripts/tools/git/hooks/post-checkout/mise-install.bash {{prev_head}} {{new_head}}"
                output_summary = "combined"
            }
        }
    }
    ["check"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
}
