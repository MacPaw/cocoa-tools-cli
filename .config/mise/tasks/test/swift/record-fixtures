#!/usr/bin/env bash

#MISE description="Regenerate test fixtures: xUnit failures (XUnitParserTests) and lcov (LLVMCoverageParserTests)"

# No set -Eeo pipefail — intentional. swift test exits non-zero due to recording
# failures, but the fixture copies must still run regardless of that exit code.

export MPCT_TESTS_RECORD_FAILURES=1
echo "Running Swift tests with MPCT_TESTS_RECORD_FAILURES=1 to capture fixture artifacts..."
./scripts/tools/swift/swift.bash --action=test --configuration=debug

ARTIFACTS_DIR="${ARTIFACTS_DIR:-"artifacts"}"
SWIFT_PACKAGE_NAME="${SWIFT_PACKAGE_NAME:-"cocoa-tools"}"

echo "Copying xUnit XML (with intentional failures and skips) → XUnitReportTests fixture..."
cp "${ARTIFACTS_DIR}/test-results/${SWIFT_PACKAGE_NAME}-debug-xUnit-swift-testing.xml" \
  "Tests/XUnitReportTests/fixtures/cocoa-tools-debug-xUnit-swift-testing.xml"

# Strip segments, the top-level functions array, and unused summary fields from the full 28MB lcov.json.
# Segments are line-by-line execution data we don't model; the functions array contains 23k+ entries
# with mangled Swift symbols. From each summary we keep only lines, functions, and branches —
# dropping instantiations, regions, and mcdc. Keeping only filename+summary per file shrinks the
# fixture to ~200KB while preserving everything the parser uses.
echo "Trimming lcov.json (removing segments, functions, instantiations, regions, mcdc) → LLVMCoverageParserTests fixture..."
jq '{type,version,data:[.data[]|{totals:{lines:.totals.lines,functions:.totals.functions,branches:.totals.branches},files:[.files[]|{filename,summary:{lines:.summary.lines,functions:.summary.functions,branches:.summary.branches}}],functions:[]}]}' \
  "${ARTIFACTS_DIR}/test-results/${SWIFT_PACKAGE_NAME}-debug-lcov.json" \
  > "Tests/LLVMCoverageParserTests/fixtures/lcov.json"

LLVM_REPO_ROOT="$(pwd)"
LLVM_FIXTURES_DIR="${LLVM_REPO_ROOT}/Tests/LLVMCoverageParserTests/fixtures"
JQ_TRIM='{type,version,data:[.data[0]|{totals:{lines:.totals.lines,functions:.totals.functions,branches:.totals.branches},files:[.files[]|select(.filename|contains("/.build/")|not)|{filename,summary:{lines:.summary.lines,functions:.summary.functions,branches:.summary.branches}}]}]}'

generate_lcov() {
  local pkg_dir="$1"
  local output_file="$2"
  (
    cd "${pkg_dir}" || exit
    swift test --enable-code-coverage 2>&1 | tail -3 || true
    local codecov_path
    codecov_path=$(swift test --enable-code-coverage --show-code-coverage-path 2> /dev/null)
    jq "${JQ_TRIM}" "${codecov_path}" > "${output_file}"
  )
}

echo "Generating llvm-diff-before.json from .xcresult-diff/Before..."
generate_lcov "${LLVM_REPO_ROOT}/.xcresult-diff/Before" "${LLVM_FIXTURES_DIR}/llvm-diff-before.json"

echo "Generating llvm-diff-after.json from .xcresult-diff/After..."
generate_lcov "${LLVM_REPO_ROOT}/.xcresult-diff/After" "${LLVM_FIXTURES_DIR}/llvm-diff-after.json"
