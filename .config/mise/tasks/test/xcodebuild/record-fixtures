#!/usr/bin/env bash

#MISE description="Build xcresult fixtures for XCResultCoverageDiff tests (Before and After packages)"

set -Eeo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"

BEFORE_DIR="${REPO_ROOT}/.xcresult-diff/Before"
AFTER_DIR="${REPO_ROOT}/.xcresult-diff/After"
ARTIFACTS_DIR="${REPO_ROOT}/artifacts/xcresult-diff"
FIXTURES_DIR="${REPO_ROOT}/Tests/XCResultParsingTests/fixtures"

mkdir -p "${ARTIFACTS_DIR}"

echo "Building Before package xcresult..."
rm -rf "${ARTIFACTS_DIR}/coverage-diff-before.xcresult"
(
  cd "${BEFORE_DIR}"
  xcodebuild test \
    -scheme "Before-Package" \
    -destination "platform=macOS" \
    -enableCodeCoverage YES \
    -resultBundlePath "${ARTIFACTS_DIR}/coverage-diff-before.xcresult" \
    -derivedDataPath "${REPO_ROOT}/.xcresult-diff/.build/Before" \
    CODE_SIGN_IDENTITY="" CODE_SIGNING_REQUIRED=NO \
    "RUN_CLANG_STATIC_ANALYZER=NO" "COMPILER_INDEX_STORE_ENABLE=NO" \
    2>&1 | grep -E "(TEST SUCCEEDED|TEST FAILED|error:)" | head -5 || true
)

echo "Building After package xcresult..."
rm -rf "${ARTIFACTS_DIR}/coverage-diff-after.xcresult"
(
  cd "${AFTER_DIR}"
  xcodebuild test \
    -scheme "After-Package" \
    -destination "platform=macOS" \
    -enableCodeCoverage YES \
    -resultBundlePath "${ARTIFACTS_DIR}/coverage-diff-after.xcresult" \
    -derivedDataPath "${REPO_ROOT}/.xcresult-diff/.build/After" \
    CODE_SIGN_IDENTITY="" CODE_SIGNING_REQUIRED=NO \
    "RUN_CLANG_STATIC_ANALYZER=NO" "COMPILER_INDEX_STORE_ENABLE=NO" \
    2>&1 | grep -E "(TEST SUCCEEDED|TEST FAILED|error:)" | head -5 || true
)

echo "Generating coverage-diff.json fixture (with path-equivalence)..."
xcrun xccov diff --json \
  --path-equivalence "${BEFORE_DIR},${AFTER_DIR}" \
  "${ARTIFACTS_DIR}/coverage-diff-before.xcresult" \
  "${ARTIFACTS_DIR}/coverage-diff-after.xcresult" \
  > "${FIXTURES_DIR}/coverage-diff.json"

echo "Done. Fixture stored at ${FIXTURES_DIR}/coverage-diff.json."
